<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET is declared SOLELY for the one-time model download (ModelDownloader.kt — the single
      lint-allowlisted network file). After first run the app makes no network calls. See
      docs/adr/0008-internet-permission-model-download.md. A future no-INTERNET build flavor will
      omit this permission and require the model to be sideloaded.
      Flashlight uses CameraManager.setTorchMode, which does NOT require CAMERA.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      WRITE_SETTINGS is a "special" permission — declared here but the user must explicitly grant it
      via Settings.ACTION_MANAGE_WRITE_SETTINGS. SetBrightness opens that page on the first call when
      Settings.System.canWrite() returns false. Used solely for screen brightness; never to read.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!--
      ACCESS_NOTIFICATION_POLICY is a "special" permission like WRITE_SETTINGS — declared here,
      granted by the user via Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS. Used by SetDnd
      (Do Not Disturb on/off) and SetRingerMode (silent mode requires it on Android 7+).
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
      Bluetooth permissions. BLUETOOTH_ADMIN auto-grants below API 31. BLUETOOTH_CONNECT is a
      runtime permission on API 31+ — Mitra checks self-permission and bounces to app details
      when missing. On API 33+ Bluetooth toggle is restricted regardless; SetBluetooth falls back
      to the Bluetooth settings page.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Android 11+ package visibility. Without these the system clock app is invisible to our
      PackageManager probes (StartTimer falls through to its last-resort path on every device),
      and launcher app discovery (open_app) returns an empty list.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Settings panels for the open_settings tool. Android 11+ visibility rule. -->
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.BLUETOOTH_SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.AIRPLANE_MODE_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.LOCATION_SOURCE_SETTINGS" /></intent>
        <intent><action android:name="android.settings.ZEN_MODE_PRIORITY_SETTINGS" /></intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="Mitra"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mitra">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|locale|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
