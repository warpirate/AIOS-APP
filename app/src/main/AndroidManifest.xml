<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      INTERNET is declared SOLELY for the one-time model download (ModelDownloader.kt — the single
      lint-allowlisted network file). After first run the app makes no network calls. See
      docs/adr/0008-internet-permission-model-download.md. A future no-INTERNET build flavor will
      omit this permission and require the model to be sideloaded.
      Flashlight uses CameraManager.setTorchMode, which does NOT require CAMERA.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      WRITE_SETTINGS is a "special" permission — declared here but the user must explicitly grant it
      via Settings.ACTION_MANAGE_WRITE_SETTINGS. SetBrightness opens that page on the first call when
      Settings.System.canWrite() returns false. Used solely for screen brightness; never to read.
    -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />

    <!--
      ACCESS_NOTIFICATION_POLICY is a "special" permission like WRITE_SETTINGS — declared here,
      granted by the user via Settings.ACTION_NOTIFICATION_POLICY_ACCESS_SETTINGS. Used by SetDnd
      (Do Not Disturb on/off) and SetRingerMode (silent mode requires it on Android 7+).
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
      Bluetooth permissions. BLUETOOTH_ADMIN auto-grants below API 31. BLUETOOTH_CONNECT is a
      runtime permission on API 31+ — Mitra checks self-permission and bounces to app details
      when missing. On API 33+ Bluetooth toggle is restricted regardless; SetBluetooth falls back
      to the Bluetooth settings page.
    -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
      Contacts read access for query_contacts. Runtime permission (API 23+). User grants reactively
      on first lookup, or proactively via Settings -> Access -> Contacts. Never written, never
      exfiltrated, never logged (AuditLog stores tool name + outcome only).
    -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!--
      Place calls directly via ACTION_CALL for make_call. Without this, Mitra falls back to
      ACTION_DIAL (opens the dialer pre-filled). With this granted, ACTION_CALL places the call
      after the in-app ConfirmationGate modal — Mitra never auto-dials silently. Runtime
      permission; user grants reactively on the first "call X" attempt or proactively via
      Settings -> View all permissions.
    -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!--
      Send SMS directly via SmsManager.sendTextMessage for send_sms. Without this, Mitra cannot
      text without falling back to ACTION_SENDTO (open the messages app pre-filled) — and we
      explicitly do not keep that fallback. With this granted, the SMS fires after the in-app
      ConfirmationGate modal — Mitra never auto-sends silently. Runtime permission; user grants
      reactively on the first "text X" attempt or proactively via Settings -> View all permissions.
    -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!--
      In-app timer fallback (StartTimer tier 4 → MitraTimerScheduler + TimerReceiver). On stock
      OxygenOS 13 / Nord 2T no clock app honours ACTION_SET_TIMER or ACTION_SET_ALARM, so Mitra
      schedules its own AlarmManager broadcast and posts a notification when it fires.

      - USE_EXACT_ALARM (API 33+): install-time grant for alarm-clock-class apps. Mitra qualifies.
      - SCHEDULE_EXACT_ALARM (API 31-32): pre-USE_EXACT_ALARM form; on API 31+ the user can revoke
        it in app info, in which case MitraTimerScheduler falls back to setAndAllowWhileIdle.
      - POST_NOTIFICATIONS (API 33+): runtime permission; without it the timer still fires but the
        notification silently drops.
      - VIBRATE: timer notification channel enables vibration.
    -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Foreground service that keeps the ~2.6 GB Gemma 4 E2B model resident in RAM across activity
      teardown / app-swipe. Eliminates the 6-12 s cold-load on re-launch. FOREGROUND_SERVICE is the
      base permission (API 28+); FOREGROUND_SERVICE_SPECIAL_USE is required from API 34+ since the
      service does not map to a standard FGS type (mediaPlayback / location / dataSync etc). The
      PROPERTY_SPECIAL_USE_FGS_SUBTYPE on the <service> declaration documents the intent.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
      Android 11+ package visibility. Without these the system clock app is invisible to our
      PackageManager probes (StartTimer falls through to its last-resort path on every device),
      and launcher app discovery (open_app) returns an empty list.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SET_TIMER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SET_ALARM" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <!-- Settings panels for the open_settings tool. Android 11+ visibility rule. -->
        <intent><action android:name="android.settings.SETTINGS" /></intent>
        <intent><action android:name="android.settings.BLUETOOTH_SETTINGS" /></intent>
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.AIRPLANE_MODE_SETTINGS" /></intent>
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <intent><action android:name="android.settings.LOCATION_SOURCE_SETTINGS" /></intent>
        <intent><action android:name="android.settings.ZEN_MODE_PRIORITY_SETTINGS" /></intent>
    </queries>

    <application
        android:name=".MitraApp"
        android:allowBackup="false"
        android:label="Mitra"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mitra">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|locale|fontScale"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Tier-4 in-app timer fallback receiver. Private (android:exported="false") — only Mitra's
          own AlarmManager broadcast can target it. Action string is namespaced.
        -->
        <receiver
            android:name=".tools.TimerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mitra.tools.action.TIMER_FIRE" />
                <action android:name="com.mitra.tools.action.TIMER_CANCEL" />
            </intent-filter>
        </receiver>

        <!--
          Brain-resident foreground service. Keeps the process at FGS oom-adj so the LLM stays
          in RAM. specialUse type because no standard FGS category fits "hold an on-device LLM
          resident"; the property documents the subtype.
        -->
        <service
            android:name=".inference.BrainResidentService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="on_device_llm_resident" />
        </service>
    </application>
</manifest>
